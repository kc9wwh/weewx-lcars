<!doctype html>
<html lang="en">
<head>
#include "inc/head.inc"
<title>$stn · History</title>
</head>
#include "inc/frame_open.inc"
<header class="console-head">
<div>
<div class="kicker">Historical archive · all time</div>
<h1>$stn</h1>
</div>
<div class="clock">
<div class="time">History</div>
<div class="when">$alltime.start.format("%d.%m.%Y") – $alltime.end.format("%d.%m.%Y") • $_nyrs $('year' if $_nyrs == 1 else 'years') · $_nmos $('month' if $_nmos == 1 else 'months')</div>
</div>
</header>

<main class="content" id="content">

<section aria-labelledby="h-all">
<div class="sect"><i class="cap c-peach"></i><h2 class="label c-peach" id="h-all">Recorded extremes · All time</h2><i class="fill"></i><i class="end"></i></div>
#set global $P = $alltime
#set global $tfmt = '%d.%m.%Y'
#include "inc/records.inc"
</section>

<section aria-labelledby="h-matrix">
<div class="sect"><i class="cap c-mist"></i><h2 class="label c-mist" id="h-matrix">Climate matrix · Monthly history</h2><i class="fill"></i><i class="end"></i></div>
<div class="hist-tabs" role="tablist" aria-label="Climate metric">
#for $_ti, $_mt in enumerate($_metrics)
<button type="button" class="hist-tab$(' is-active' if $_ti == 0 else '')" role="tab" id="tab-$_mt[0]" aria-controls="panel-$_mt[0]" aria-selected="$('true' if $_ti == 0 else 'false')" tabindex="$('0' if $_ti == 0 else '-1')" data-matrix-tab="$_mt[0]">$_mt[1]</button>
#end for
</div>
#for $_mt in $_metrics
#set $_mid = $_mt[0]
#set $_mlabel = $_mt[1]
#set $_mdesc = $_mt[2]
#set $_munit = $_mt[3]
#set $_mulbl = $_mt[4]
#set $_mcol = $_mt[5]
#set $_mfoot_lbl = $_mt[6]
<div class="hist-panel" id="panel-$_mid" role="tabpanel" aria-labelledby="tab-$_mid" data-matrix-panel="$_mid">
<div class="hist-meta">
<span><strong>$_mlabel</strong>#if $_mulbl# · $_mulbl#end if# — $_mdesc</span>
<span class="hist-hint">Select any year or month to open its archive</span>
</div>
<div class="table-wrap">
<table class="hist-table">
<thead>
<tr>
<th scope="col" class="yr-col">Year</th>
#for $_abbr in $_mo_abbrs
<th scope="col">$_abbr</th>
#end for
<th scope="col" class="yr-sum">$_mcol</th>
<th scope="col" class="noaa-col">NOAA</th>
</tr>
</thead>
<tbody>
#for $_r in $_rows
<tr>
<th scope="row" class="yr-col">
#if $_r['has_page']
<a class="yr-link" href="year-${_r['ynum']}.html">$_r['ynum']</a>
#else
<span>$_r['ynum']</span>
#end if
</th>
#for $_mi in range(1, 13)
#set $_cell = $_r['cells'].get($_mi)
#set $_val = $_cell.get($_mid) if $_cell else None
#if $_val is not None
<td data-metric="$_mid" data-unit="$_munit" data-val="$_val['raw']">
#if $_cell['has_page']
<a href="month-${_cell['mkey']}.html" title="$_mo_fulls[$_mi - 1] $_r['ynum'] archive">$_val['fmt']</a>
#else
<span>$_val['fmt']</span>
#end if
</td>
#else
<td class="is-empty">–</td>
#end if
#end for
#set $_ys = $_r['sum'].get($_mid)
<td class="yr-sum">
#if $_ys is not None
#if $_r['has_page']
<a href="year-${_r['ynum']}.html">$_ys</a>
#else
<span>$_ys</span>
#end if
#else
–
#end if
</td>
<td class="noaa-col">
#if $_r['has_page']
<a class="noaa-chip" href="NOAA/NOAA-${_r['ynum']}.txt" data-noaa-src="NOAA/NOAA-${_r['ynum']}.txt" data-noaa-title="NOAA Annual Summary · $_r['ynum']">TXT</a>
#else
–
#end if
</td>
</tr>
#end for
</tbody>
#if $_nyrs >= 2
#set $_fr = $_foot_rows[$_mid]
<tfoot>
<tr>
<th scope="row" class="yr-col">$_mfoot_lbl</th>
#for $_mi in range(1, 13)
#set $_fv = $_fr['cells'].get($_mi)
<td class="foot-cell">$($_fv if $_fv is not None else '–')</td>
#end for
<td class="yr-sum foot-cell">$_fr['overall']</td>
<td class="noaa-col foot-cell">–</td>
</tr>
</tfoot>
#end if
</table>
</div>
</div>
#end for
</section>

<section aria-labelledby="h-logs">
<div class="sect"><i class="cap c-coral"></i><h2 class="label c-coral" id="h-logs">Archive logs · Period &amp; NOAA reports</h2><i class="fill"></i><i class="end"></i></div>
<div class="archive-list">
#for $_r in $_rows
<div class="archive-year">
<div class="archive-year-head">
#if $_r['has_page']
<a class="btn c-peach archive-yr-btn" href="year-${_r['ynum']}.html">$_r['ynum']</a>
#else
<span class="btn c-peach archive-yr-btn">$_r['ynum']</span>
#end if
<div class="archive-yr-stats">$_r['stats']</div>
#if $_r['has_page']
<a class="pill-btn c-lav" href="NOAA/NOAA-${_r['ynum']}.txt" data-noaa-src="NOAA/NOAA-${_r['ynum']}.txt" data-noaa-title="NOAA Annual Summary · $_r['ynum']">NOAA $_r['ynum']</a>
#end if
</div>
<div class="archive-months">
#for $_mi, $_abbr in enumerate($_mo_abbrs, 1)
#set $_cell = $_r['cells'].get($_mi)
#if $_cell is not None and $_cell['has_page']
<div class="archive-month">
<div class="archive-month-head">
<a class="archive-month-name" href="month-${_cell['mkey']}.html">$_abbr</a>
<a class="noaa-chip" href="NOAA/NOAA-${_cell['mkey']}.txt" data-noaa-src="NOAA/NOAA-${_cell['mkey']}.txt" data-noaa-title="NOAA Monthly Summary · $_mo_fulls[$_mi - 1] $_r['ynum']">NOAA</a>
</div>
<a class="archive-month-stats" href="month-${_cell['mkey']}.html">
#if $_cell['temp_rng']
<b>$_cell['temp_rng']<small>$unit.label.outTemp.strip()</small></b>
#end if
#if $_cell['rain_str']
<span>$_cell['rain_str']</span>
#elif $_cell['wind_str']
<span>$_cell['wind_str']</span>
#end if
</a>
</div>
#else
<div class="archive-month is-empty"><span class="archive-month-name">$_abbr</span><span class="archive-month-none">No data</span></div>
#end if
#end for
</div>
</div>
#end for
</div>
</section>

<section aria-labelledby="h-trend">
<div class="sect"><i class="cap c-lav"></i><h2 class="label c-lav" id="h-trend">Trend bay · $_trend_lbl</h2><i class="fill"></i></div>
<div class="charts" data-charts></div>
</section>

</main>
#include "inc/frame_close.inc"
#include "inc/noaa_dialog.inc"
<script type="application/json" id="wx-charts">
$json.dumps($_chart_payload)
</script>
#include "inc/config.inc"
<script src="vendor/apexcharts.min.js" defer></script>
<script src="lcars.js" defer></script>
</body>
</html>
